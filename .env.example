APP_NAME="Thabekhulu Development Software"

# Sign-in page branding (see config/branding.php)
BRAND_NAME="Thabekhulu Development Software"
BRAND_SHORT_NAME="Thabekhulu"
BRAND_OWNER="Steve Maqueens and Thabekhulu Development Group"
BRAND_LOGO=
BRAND_PRIVACY_URL=
BRAND_POWERED_BY="Mayura Consultancy Services"
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS="Monday to Friday, 08:00 to 17:00"

# POPIA Information Officer (shown on the POPIA page)
POPIA_INFORMATION_OFFICER=
POPIA_INFORMATION_OFFICER_EMAIL=

# Programme: building industry December shutdown (month-day); leave empty to switch off
PROGRAMME_SHUTDOWN_FROM=12-16
PROGRAMME_SHUTDOWN_TO=01-09
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Stored timestamps are UTC; the UI displays this timezone.
APP_DISPLAY_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose defaults (see docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=thabekhulu
DB_USERNAME=thabekhulu
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@thabekhulu.local"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Initial Super Admin created by the seeder (change immediately after first login)
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=admin@thabekhulu.local
SUPER_ADMIN_PASSWORD=ChangeMe!2026

# Sanctum: domains whose browser requests are authenticated by session cookie (site app dev server included)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5174

# Site app (PWA) API base URL
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
